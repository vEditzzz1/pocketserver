  "images": [
    {
      "id": "nginx",
      "name": "nginx",
      "image": "nginx:alpine",
      "category": "web",
      "official": true,
      "icon": "https://raw.githubusercontent.com/docker-library/docs/master/nginx/logo.svg",
      "color": "#009639",
      "mono": "N",
      "description": "Serves a folder over HTTP, 3 MB image.",
      "port": 8080,
      "command": "sh -c 'sed -i \"s/listen  *80;/listen $PS_PORT;/g\" /etc/nginx/conf.d/default.conf && exec nginx -g \"daemon off;\"'",
      "workdir": "/",
      "env": [],
      "volumes": [{ "host": "$SITE", "guest": "/usr/share/nginx/html" }],
      "note": "The site folder is mounted as the web root. Logs appear here, not in a log file."
    },
    {
      "id": "httpd",
      "name": "Apache httpd",
      "image": "httpd:alpine",
      "category": "web",
      "official": true,
      "icon": "https://raw.githubusercontent.com/docker-library/docs/master/httpd/logo.svg",
      "color": "#D22128",
      "mono": "A",
      "description": "Apache HTTP server, 60 MB image.",
      "port": 8080,
      "command": "httpd -f -p $PS_PORT -h /usr/local/apache2/htdocs",
      "workdir": "/",
      "env": [],
      "volumes": [{ "host": "$SITE", "guest": "/usr/local/apache2/htdocs" }],
      "note": "Serves the site folder. The container port must match the site port."
    },
    {
      "id": "caddy",
      "name": "Caddy",
      "image": "caddy:alpine",
      "category": "web",
      "official": true,
      "icon": "https://raw.githubusercontent.com/docker-library/docs/master/caddy/logo.png",
      "color": "#1F88C0",
      "mono": "C",
      "description": "Static file server with automatic headers.",
      "port": 8080,
      "command": "caddy file-server --listen :$PS_PORT --root /site",
      "workdir": "/",
      "env": [],
      "volumes": [],
      "note": "Serves /site directly, so the folder is always current."
    },
    {
      "id": "redis",
      "name": "Redis",
      "image": "redis:alpine",
      "category": "db",
