      "icon": "https://raw.githubusercontent.com/docker-library/docs/master/redis/logo.png",
      "color": "#DC382D",
      "mono": "R",
      "description": "In-memory key/value store, 30 MB image.",
      "port": 6379,
      "command": "redis-server --save 60 1 --appendonly no --dir /data --port $PS_PORT",
      "workdir": "/",
      "env": [],
      "volumes": [{ "host": "$SITE/data", "guest": "/data" }],
      "note": "Data lives in the site folder under data/."
    },
    {
      "id": "memcached",
      "name": "Memcached",
      "image": "memcached:alpine",
      "category": "db",
      "official": true,
      "icon": "",
      "color": "#0B5C6B",
      "mono": "M",
      "description": "Small in-memory cache server.",
      "port": 11211,
      "command": "memcached -m 64 -u root -p $PS_PORT",
      "workdir": "/",
      "env": [],
      "volumes": [],
      "note": "Runs as the emulated root, hence -u root."
    },
    {
      "id": "mariadb",
      "name": "MariaDB",
      "image": "mariadb:latest",
      "category": "db",
      "official": true,
      "icon": "https://raw.githubusercontent.com/docker-library/docs/master/mariadb/logo.png",
      "color": "#003545",
      "mono": "M",
      "description": "MySQL-compatible database, ~400 MB image.",
      "port": 3306,
      "command": "sh -c '[ -d /data/mysql ] || mariadb-install-db --user=root --datadir=/data >/dev/null; exec mariadbd --user=root --datadir=/data --bind-address=0.0.0.0 --port=$PS_PORT'",
      "workdir": "/",
      "env": [],
      "volumes": [{ "host": "$SITE/data", "guest": "/data" }],
      "note": "First start initialises the data directory. Root has no password — local use only."
    },
    {
      "id": "postgres",
      "name": "PostgreSQL",
      "image": "postgres:alpine",
      "category": "db",
      "official": true,
      "icon": "https://raw.githubusercontent.com/docker-library/docs/master/postgres/logo.png",
      "color": "#336791",
      "mono": "P",
      "description": "PostgreSQL database, ~250 MB image.",
      "port": 5432,
      "command": "sh -c '[ -d /data/base ] || initdb -D /data >/dev/null; exec postgres -D /data -k /tmp -p $PS_PORT'",
      "workdir": "/",
      "user": "70:70",
      "env": [],
      "volumes": [{ "host": "$SITE/data", "guest": "/data" }],
      "note": "Experimental: initdb refuses to run as root, so this one runs as uid 70. Check the console on first start."
    },
